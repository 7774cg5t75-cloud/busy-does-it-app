{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "BUSY_BUILD_PROFILE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "BUSY_BUILD_PROFILE": "preview"
      },
      "channel": "preview"
    },
    "production": {
      "node": "22.13.0",
      "autoIncrement": true,
      "env": {
        "BUSY_BUILD_PROFILE": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
