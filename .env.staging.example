# V3.125 staging-only example. Do not activate until an independent staging
# Supabase project and host have been approved. Never copy production tokens.
# Expo public variables are bundled into the app; ONLY publishable keys go here.
# Actual values should be configured as environment variables outside Git.
EXPO_PUBLIC_BUSY_AI_URL=https://YOUR_NEW_STAGING_PROJECT_REF.supabase.co/functions/v1/busy-ai-intake
EXPO_PUBLIC_BUSY_AI_TOKEN=sb_publishable_REPLACE_WITH_NEW_STAGING_PUBLISHABLE_KEY
# EAS preview channel already exists in eas.json. No signed build is launched.
