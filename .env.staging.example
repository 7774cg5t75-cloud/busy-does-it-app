# V3.128 internal staging build metadata only, NOT a live environment.
# Do not use the Busy Does It or Slow Roast existing project URL/key.
# Actual values must be supplied for the dedicated EAS staging environment
# after separate Supabase provisioning and cost/permission approval.
EXPO_PUBLIC_BUSY_ENVIRONMENT=isolated-staging
EXPO_PUBLIC_BUSY_STAGING_SUPABASE_URL=
EXPO_PUBLIC_BUSY_STAGING_PUBLISHABLE_KEY=
# Expo public values are embedded in clients. Never put Supabase secret keys,
# JWT sessions, paid-provider credentials or private user data in EXPO_PUBLIC.
# Leaving these blank deliberately makes staging offline; it cannot fall
# back to either existing live Supabase project.
